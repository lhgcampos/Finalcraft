    <Paragraph Type="Parenthetical" LeftIndent="3"><Text Font="Courier Prime" Size="12">(ao rádio)</Text></Paragraph>
    <Paragraph Type="Dialogue" LeftIndent="2.5" RightIndent="6"><Text Font="Courier Prime" Size="12">Ouvem-me?</Text></Paragraph>
    <Paragraph Type="Shot"><Text Font="Courier Prime" Size="12">O MOSTRADOR</Text></Paragraph>
    <Paragraph Type="Transition" Alignment="Right"><Text Font="Courier Prime" Size="12" Style="Underline">CORTE.</Text></Paragraph>
    <Paragraph Type="Nota"><Text Font="Courier Prime" Size="12">Amanhã.</Text></Paragraph>
